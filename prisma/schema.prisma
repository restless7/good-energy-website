// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ConferenceReservation {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  country   String
  mode      String   // "virtual" or "presencial"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conference_reservations")
}

model User {
  id             String          @id @default(cuid())
  clerkUserId    String?         @unique
  name           String
  email          String          @unique
  phone          String?
  country        String?
  avatar         String?
  isActive       Boolean         @default(true)
  investments      Investment[]
  earnings         Earning[]
  partnerProfile   PartnerProfile?
  investorProfile  InvestorProfile?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("users")
}

model SolarPlant {
  id            String   @id @default(cuid())
  name          String
  location      String
  coordinates   String?  // "lat,lng"
  capacity      Float    // kW capacity
  energyGenerated Float @default(0) // Total kWh generated
  status        String   @default("En construcción") // En construcción, En operación, Mantenimiento
  startDate     DateTime?
  completionDate DateTime?
  investments   Investment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("solar_plants")
}

model Investment {
  id          String   @id @default(cuid())
  userId      String
  plantId     String?
  type        String   // "Base", "Crecimiento", "Premium"
  amount      Float    // Investment amount in COP
  currency    String   @default("COP")
  roi         Float    // Expected annual ROI percentage
  actualRoi   Float?   // Actual ROI achieved
  status      String   @default("Activa") // Activa, Completada, Cancelada
  startDate   DateTime @default(now())
  maturityDate DateTime?
  earnings    Earning[]
  drawdowns   CapitalDrawdown[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plant       SolarPlant? @relation(fields: [plantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("investments")
}

model Earning {
  id            String   @id @default(cuid())
  userId        String
  investmentId  String
  amount        Float    // Earning amount in COP
  currency      String   @default("COP")
  type          String   // "Ganancia", "Reinversión", "Interés"
  status        String   @default("Pendiente") // Pendiente, Pagado, Procesando
  paymentDate   DateTime?
  paymentMethod String?  // "Transferencia", "PayU", "Stripe"
  taxWithheld   Float    @default(0)
  netAmount     Float    // Amount after taxes
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  investment    Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("earnings")
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String   // Markdown or Rich Text
  coverImage  String?
  publishedAt DateTime?
  authorId    String
  author      Author   @relation(fields: [authorId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("posts")
}

model Author {
  id        String   @id @default(cuid())
  name      String
  avatar    String?
  bio       String?
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("authors")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

// ===========================
// PARTNER OPERATIONS MODULE
// ===========================

model PartnerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  bio         String?
  isActive    Boolean  @default(true)
  goals       PartnerGoal[]
  milestones  Milestone[]
  tasks       PartnerTask[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("partner_profiles")
}

model PartnerGoal {
  id               String   @id @default(cuid())
  partnerProfileId String
  partnerProfile   PartnerProfile @relation(fields: [partnerProfileId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  targetMetric     String
  currentProgress  Float    @default(0)
  targetValue      Float
  status           String   @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | ACHIEVED | AT_RISK
  startDate        DateTime @default(now())
  deadline         DateTime?
  milestones       Milestone[]
  tasks            PartnerTask[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("partner_goals")
}

model Milestone {
  id               String   @id @default(cuid())
  partnerProfileId String
  partnerProfile   PartnerProfile @relation(fields: [partnerProfileId], references: [id], onDelete: Cascade)
  goalId           String?
  goal             PartnerGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  dueDate          DateTime?
  isCompleted      Boolean  @default(false)
  completedAt      DateTime?
  tasks            PartnerTask[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("milestones")
}

model PartnerTask {
  id               String   @id @default(cuid())
  partnerProfileId String
  partnerProfile   PartnerProfile @relation(fields: [partnerProfileId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  status           String   @default("BACKLOG") // BACKLOG | TODO | IN_PROGRESS | REVIEW | DONE
  priority         String   @default("MEDIUM")  // LOW | MEDIUM | HIGH | CRITICAL
  dueDate          DateTime?
  assignedBy       String   // clerkUserId of the SUPER_ADMIN who created the task
  goalId           String?
  goal             PartnerGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestoneId      String?
  milestone        Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("partner_tasks")
}

// ===========================
// PREMIUM MOBILITY & GRID ARBITRAGE
// ===========================

model InvestorProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                 String   @default("FOUNDATIONAL") // FOUNDATIONAL
  totalCapitalPlaced   Float    @default(0)
  projectedIrrMin      Float    @default(0)
  projectedIrrMax      Float    @default(0)
  capexAllocation      Float    @default(0) // 70%
  realEstateAllocation Float    @default(0) // 20%
  operationsAllocation Float    @default(0) // 10%
  leaseContractStatus  String   @default("ACTIVE") // ACTIVE, RENEWAL_PENDING
  liquidityHorizon     DateTime?
  nodes                Node[]   // Asset Portability Registry
  simulations          SimulatedScenario[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("investor_profiles")
}

model Node {
  id               String   @id @default(cuid())
  serialNumber     String   @unique
  name             String
  location         String
  tier             String   // Tier 01 (60kW), Tier 02 (120kW), Tier 03 (240kW)
  status           String   @default("NORMAL")
  warrantyActive   Boolean  @default(true)
  warrantyExpDate  DateTime?
  currentLoadKw    Float    @default(0)
  dailyUtilization Float    @default(0) // percentage
  coreVolumeKwh    Float    @default(0)
  avgDwellTimeMins Float    @default(0)
  investorId       String?
  investor         InvestorProfile? @relation(fields: [investorId], references: [id], onDelete: SetNull)
  sessions         RetailSession[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("nodes")
}

model CapitalDrawdown {
  id            String   @id @default(cuid())
  investmentId  String
  investment    Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  phase         String   // "PHASE_01_IMPORT", "PHASE_02_CIVIL", "PHASE_03_ENERGIZATION"
  description   String
  percentage    Float    // 50, 20, 30
  amount        Float
  status        String   @default("ESCROWED") // ESCROWED, DISBURSED
  pdfUrl        String?  // Field PDFs
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("capital_drawdowns")
}

model RetailSession {
  id                 String   @id @default(cuid())
  nodeId             String
  node               Node     @relation(fields: [nodeId], references: [id])
  sessionStart       DateTime
  sessionEnd         DateTime
  durationMinutes    Float
  energyDeliveredKwh Float
  grossBilling       Float
  energyInputCost    Float
  source             String   @default("SOLAR_PARK") // SOLAR_PARK, GRID
  tier               String   // e.g., TIER_01, TIER_02
  platformFee        Float    @default(0) // 30% split
  partnerUtility     Float    @default(0) // 70% split
  payoutStatus       String   @default("PENDING") // PENDING, PROCESSING, SETTLED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("retail_sessions")
}

model SimulatedScenario {
  id                String   @id @default(cuid())
  leadName          String
  leadEmail         String
  leadPhone         String
  assetType         String   // "ELECTROLINERA" or "SOLAR_FARM"
  selectedTier      String?  // e.g., 'TIER_1', 'TIER_2', 'TIER_3'
  unitsCount        Int      @default(1)
  customParameters  Json     // { vehicleCapacity, retailPrice, wholesalePrice, inflation, growth }
  investorProfileId String?
  investorProfile   InvestorProfile? @relation(fields: [investorProfileId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())

  @@map("simulated_scenarios")
}

model EnergySpotPrice {
  id              String   @id @default(cuid())
  hourlyTimestamp DateTime
  pricePerKWh     Float
  gridRegion      String
  createdAt       DateTime @default(now())

  @@unique([hourlyTimestamp, gridRegion])
  @@map("energy_spot_prices")
}
